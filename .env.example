# Copy to .env (repository root) or to backend/.env and frontend/.env.
# The backend reads GYM_* variables; Vite reads VITE_* variables from frontend/.env.

# ---- Backend (FastAPI) ----
# Folder that holds members.json, memberships.json and payments.json.
# Leave empty to use backend/app/data.
GYM_DATA_DIR=

# Comma-separated browser origins allowed to call the API.
GYM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A membership counts as "expiring soon" when it ends within this many days.
GYM_EXPIRY_WARNING_DAYS=7

# Create demo plans, members and payments on first start when every data file is empty.
GYM_SEED_DEMO_DATA=true

# ---- Frontend (Vite) ----
# Base URL of the backend, without a trailing slash and without /api.
VITE_API_BASE_URL=http://localhost:8000
